<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eversec.llmops.service.mapper.DatasetMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.eversec.llmops.service.entity.Dataset">
        <id column="id" property="id" />
        <result column="created_on" property="createdOn" />
        <result column="changed_on" property="changedOn" />
        <result column="name" property="name" />
        <result column="label" property="label" />
        <result column="`describe`" property="describe" />
        <result column="source_type" property="sourceType" />
        <result column="source" property="source" />
        <result column="industry" property="industry" />
        <result column="icon" property="icon" />
        <result column="field" property="field" />
        <result column="usage" property="usage" />
        <result column="research" property="research" />
        <result column="storage_class" property="storageClass" />
        <result column="file_type" property="fileType" />
        <result column="status" property="status" />
        <result column="years" property="years" />
        <result column="url" property="url" />
        <result column="path" property="path" />
        <result column="download_url" property="downloadUrl" />
        <result column="storage_size" property="storageSize" />
        <result column="entries_num" property="entriesNum" />
        <result column="duration" property="duration" />
        <result column="price" property="price" />
        <result column="owner" property="owner" />
        <result column="expand" property="expand" />
        <result column="created_by_fk" property="createdByFk" />
        <result column="changed_by_fk" property="changedByFk" />
        <result column="doc" property="doc" />
        <result column="features" property="features" />
        <result column="info" property="info" />
        <result column="metric_info" property="metricInfo" />
        <result column="secret" property="secret" />
        <result column="segment" property="segment" />
        <result column="split" property="split" />
        <result column="subdataset" property="subdataset" />
        <result column="version" property="version" />
        <result column="project_id" property="projectId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        created_on, changed_on, id, name, label, `describe`, source_type, source, industry, icon, field, `usage`, research, storage_class, file_type, status, years, url, path, download_url, storage_size, entries_num, duration, price, owner, expand, created_by_fk, changed_by_fk, doc, features, info, metric_info, secret, segment, split, subdataset, version,project_id
    </sql>

    <!-- 自定义分页查询 -->
    <select id="customGetPageList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM dataset
        <where>
            <choose>
                <when test="projectId != null">
                    AND project_id =  #{projectId}
                </when>
                <otherwise>
                    AND project_id = 1
                </otherwise>
            </choose>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="version != null and version != ''">
                AND version LIKE CONCAT('%', #{version}, '%')
            </if>
            <if test="describe != null and describe != ''">
                AND `describe` LIKE CONCAT('%', #{describe}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 获取数据集总数 -->
    <select id="customGetTotalCount" resultType="int">
        SELECT COUNT(*)
        FROM dataset
        <where>
            <choose>
                <when test="projectId != null">
                    AND project_id IN (1, #{projectId})
                </when>
                <otherwise>
                    AND project_id = 1
                </otherwise>
            </choose>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="version != null and version != ''">
                AND version LIKE CONCAT('%', #{version}, '%')
            </if>
            <if test="describe != null and describe != ''">
                AND `describe` LIKE CONCAT('%', #{describe}, '%')
            </if>
        </where>
    </select>

    <select id="getById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM dataset
        WHERE id = #{id}
    </select>

    <select id="getCountByProjectId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM dataset
        WHERE project_id = #{projectId}
    </select>
    
</mapper>
