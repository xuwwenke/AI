APP_NAME=k8s-intelligent-agent
APP_ENV=development
DEBUG=true

# LLM Provider: ollama / openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b

# Ollama
OLLAMA_BASE_URL=http://192.168.224.248:11434

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Kubernetes
K8S_IN_CLUSTER=false
K8S_KUBECONFIG=

# Prometheus
PROMETHEUS_URL=http://192.168.98.129:30090
PROMETHEUS_TIMEOUT=10

# Agent
AGENT_MAX_ITERATIONS=5